# Copy to .env and fill in your keys there. Never commit .env or paste keys in chat.
GEMINI_API_KEY_PRIMARY=YOUR_API_KEY_HERE
GEMINI_API_KEY_FALLBACK_1=YOUR_API_KEY_HERE
GEMINI_API_KEY_FALLBACK_2=YOUR_API_KEY_HERE

GEMINI_MODEL=gemini-3.8-flash
GEMINI_ENABLED=true
GEMINI_MAX_IMAGES=11
GEMINI_MAX_TOTAL_ATTEMPTS=11
GEMINI_REQUEST_TIMEOUT_SECONDS=45
GEMINI_TEMPERATURE=0
GEMINI_CACHE_DIR=runs/gemini_cache

# Optional, for cost reporting (USD per 1M tokens); leave empty if unknown
GEMINI_PRICE_INPUT_PER_MTOK=
GEMINI_PRICE_OUTPUT_PER_MTOK=
